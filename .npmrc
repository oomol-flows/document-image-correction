# npm configuration for faster downloads
# Uncomment the registry line below to use Taobao mirror (recommended for China users)

# registry=https://registry.npmmirror.com

# Timeout settings (in milliseconds)
timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Cache settings
cache-min=3600
prefer-offline=true

# Disable unnecessary features for faster installation
audit=false
fund=false
save-exact=true

# Progress display
progress=true
loglevel=error
